<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ElPastillero" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/verde_primario</item>
        <item name="colorPrimaryVariant">@color/verde_oscuro</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorSecondary">@color/acento</item>
        <item name="colorSecondaryVariant">@color/acento_oscuro</item>
        <item name="colorOnSecondary">@color/negro</item>
        <item name="android:statusBarColor">@color/verde_oscuro</item>
        <item name="android:windowBackground">@color/fondo</item>
    </style>

    <style name="Estilo.Titulo">
        <item name="android:textSize">@dimen/texto_titulo</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/verde_primario</item>
    </style>

    <style name="Estilo.Tarjeta">
        <item name="cardCornerRadius">@dimen/radio_tarjeta</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/tarjeta</item>
    </style>

    <style name="Estilo.Etiqueta">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

</resources>
