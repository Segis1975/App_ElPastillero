<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Invitacion">

    <TextView
        android:id="@+id/lbCorreo"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="Correo electrónico:"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/lbAsunto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/correo"
        />

    <EditText
        android:id="@+id/correo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/asunto"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/lbCorreo"
        />
    <TextView
        android:id="@+id/lbAsunto"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="Asunto: "
        app:layout_constraintBottom_toTopOf="@id/lbmensaje"
        app:layout_constraintTop_toBottomOf="@id/lbCorreo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/asunto"
        />

    <EditText
        android:id="@+id/asunto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Me gustaría que empezaras a usar esta APP"
        app:layout_constraintStart_toEndOf="@id/lbAsunto"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/correo"
        app:layout_constraintBottom_toTopOf="@id/mensaje"
        />

    <TextView
        android:id="@+id/lbmensaje"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:gravity="center_vertical"
        android:text="Mensaje"
        app:layout_constraintBottom_toTopOf="@id/btnEnviar"
        app:layout_constraintEnd_toStartOf="@id/mensaje"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lbAsunto" />

    <EditText
        android:id="@+id/mensaje"
        android:layout_width="wrap_content"
        android:layout_height="150dp"
        android:ems="10"
        android:gravity="center_vertical"
        android:inputType="text"
        app:layout_constraintBottom_toTopOf="@id/btnEnviar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/lbmensaje"
        app:layout_constraintTop_toBottomOf="@id/asunto" />

    <Button
        android:id="@+id/btnEnviar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="Enviar"
        android:backgroundTint="#4CAF50"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mensaje" />

</androidx.constraintlayout.widget.ConstraintLayout>