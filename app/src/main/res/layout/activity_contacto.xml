<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/idApp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Contacto"
    tools:ignore="ExtraText">

    <TextView
        android:id="@+id/lbNombreC"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:text="@string/nombreF"
        app:layout_constraintBottom_toTopOf="@id/lbTelefonoC"
        app:layout_constraintEnd_toStartOf="@id/txtNombreF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/txtNombreF"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:ems="10"
        android:hint="@string/_4"
        android:inputType="text"
        app:layout_constraintBottom_toTopOf="@id/txtTelefonoC"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/lbNombreC"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="Autofill,LabelFor" />

    <TextView
        android:id="@+id/lbTelefonoC"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:text="@string/tel_fono"
        app:layout_constraintBottom_toTopOf="@id/lbEMailF"
        app:layout_constraintEnd_toStartOf="@id/txtTelefonoC"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lbNombreC" />

    <EditText
        android:id="@+id/txtTelefonoC"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:ems="10"
        android:importantForAutofill="no"
        android:inputType="text"
        app:layout_constraintBottom_toTopOf="@id/txtEMailC"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/lbTelefonoC"
        app:layout_constraintTop_toBottomOf="@id/txtNombreF"
        tools:ignore="LabelFor,SpeakableTextPresentCheck" />

        />

    <TextView
        android:id="@+id/lbEMailF"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:autofillHints=""
        android:gravity="center_vertical"
        android:text="@string/e_mail"
        app:layout_constraintBottom_toTopOf="@id/lbParentesco"
        app:layout_constraintEnd_toStartOf="@id/txtEMailC"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lbTelefonoC" />
    />

    <EditText
        android:id="@+id/txtEMailC"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:autofillHints=""
        android:ems="10"
        android:inputType="text"
        app:layout_constraintBottom_toTopOf="@id/txtParentescC"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/lbEMailF"
        app:layout_constraintTop_toBottomOf="@id/txtTelefonoC"
        tools:ignore="LabelFor,SpeakableTextPresentCheck,TextFields,TouchTargetSizeCheck" />
    />

    <TextView
        android:id="@+id/lbParentesco"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:text="@string/parentesco"
        app:layout_constraintBottom_toTopOf="@id/chNotificacionesC"
        app:layout_constraintEnd_toStartOf="@id/txtParentescC"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lbEMailF" />

    <EditText
        android:id="@+id/txtParentescC"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:autofillHints=""
        android:ems="10"
        android:inputType="text"
        app:layout_constraintBottom_toTopOf="@id/chNotificacionesC"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/lbParentesco"
        app:layout_constraintTop_toBottomOf="@id/txtEMailC"
        tools:ignore="LabelFor,SpeakableTextPresentCheck" />

    <CheckBox
        android:id="@+id/chNotificacionesC"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/recibe_las_notifiacaciones"
        app:layout_constraintBottom_toTopOf="@id/btnCancelarC"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtParentescC" />

    <Button
        android:id="@+id/btnGuardarF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#4CAF50"
        android:text="@string/aceptarF"
        android:textColor="#263238"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnCancelarC"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chNotificacionesC" />

    <Button
        android:id="@+id/btnCancelarC"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#4CAF50"
        android:text="@string/CancelarF"
        android:textColor="#263238"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnGuardarF"
        app:layout_constraintTop_toBottomOf="@id/chNotificacionesC" />

</androidx.constraintlayout.widget.ConstraintLayout>