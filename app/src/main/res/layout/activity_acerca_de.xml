<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/margen_grande">

        <ImageView
            android:id="@+id/imgLogoAcerca"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/cd_logo"
            android:src="@drawable/icono" />

        <TextView
            style="@style/Estilo.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen_pequeno"
            android:gravity="center"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/txtVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/texto_secundario" />

        <TextView
            android:id="@+id/txtDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen"
            android:text="@string/acerca_descripcion" />

        <TextView
            android:id="@+id/txtAutor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen"
            android:text="@string/acerca_autor"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTecnologias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen_pequeno"
            android:text="@string/acerca_tecnologias"
            android:textColor="@color/texto_secundario" />

        <TextView
            android:id="@+id/txtManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen_pequeno"
            android:text="@string/acerca_manual"
            android:textColor="@color/texto_secundario" />

        <TextView
            android:id="@+id/txtRepo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen_grande"
            android:gravity="center"
            android:padding="@dimen/margen_pequeno"
            android:text="@string/acerca_repo"
            android:textColor="@color/verde_primario"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
