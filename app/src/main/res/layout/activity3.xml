<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity_3">

    <Button
        android:id="@+id/btn1"
        android:layout_width="53dp"
        android:layout_height="48dp"
        android:backgroundTint="#4CAF50"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/_1"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/btn4"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/btn2"
        app:layout_constraintTop_toTopOf="parent"/>

    <Button
        android:id="@+id/btn2"
        android:layout_width="53dp"
        android:layout_height="48dp"
        android:backgroundTint="#4CAF50"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/_2"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/btn5"
        app:layout_constraintLeft_toRightOf="@id/btn1"
        app:layout_constraintRight_toLeftOf="@id/btn3"
        app:layout_constraintTop_toTopOf="parent"/>


    <Button
        android:id="@+id/btn3"
        android:layout_width="53dp"
        android:layout_height="48dp"
        android:backgroundTint="#4CAF50"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/_3"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/btn6"
        app:layout_constraintLeft_toRightOf="@id/btn2"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


    <Button
        android:id="@+id/btn4"
        android:layout_width="53dp"
        android:layout_height="48dp"
        android:backgroundTint="#4CAF50"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/_4"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/btn7"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/btn5"
        app:layout_constraintTop_toBottomOf="@id/btn1"/>

    <Button
        android:id="@+id/btn5"
        android:layout_width="53dp"
        android:layout_height="48dp"
        android:backgroundTint="#4CAF50"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/_5"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/btn8"
        app:layout_constraintLeft_toRightOf="@id/btn4"
        app:layout_constraintRight_toLeftOf="@id/btn6"
        app:layout_constraintTop_toBottomOf="@id/btn2"/>


    <Button
        android:id="@+id/btn6"
        android:layout_width="53dp"
        android:layout_height="48dp"
        android:backgroundTint="#4CAF50"
        android:gravity="center"
        android:padding="10dp"
        android:text="6"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/btn9"
        app:layout_constraintLeft_toRightOf="@id/btn5"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn3"/>


    <Button
        android:id="@+id/btn7"
        android:layout_width="53dp"
        android:layout_height="48dp"
        android:backgroundTint="#4CAF50"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/_7"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/teclaPulsada"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/btn8"
        app:layout_constraintTop_toBottomOf="@id/btn4"/>

    <Button
        android:id="@+id/btn8"
        android:layout_width="53dp"
        android:layout_height="48dp"
        android:backgroundTint="#4CAF50"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/_8"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/teclaPulsada"
        app:layout_constraintLeft_toRightOf="@id/btn7"
        app:layout_constraintRight_toLeftOf="@id/btn9"
        app:layout_constraintTop_toBottomOf="@id/btn5"/>


    <Button
        android:id="@+id/btn9"
        android:layout_width="53dp"
        android:layout_height="48dp"
        android:backgroundTint="#4CAF50"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/_9"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/teclaPulsada"
        app:layout_constraintLeft_toRightOf="@id/btn8"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn6"
        />

    <TextView
        android:id="@+id/teclaPulsada"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pulsa una letra"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/labelnumero"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn8" />

    <TextView
        android:id="@+id/labelnumero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Introduce un número:"
        tools:layout_editor_absoluteX="43dp"
        tools:layout_editor_absoluteY="673dp"
        app:layout_constraintTop_toBottomOf="@id/teclaPulsada"
        app:layout_constraintBottom_toTopOf="@id/grupobtn"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/txtnumero"
        />

    <EditText
        android:id="@+id/txtnumero"
        android:layout_width="172dp"
        android:layout_height="49dp"
        android:ems="10"
        android:inputType="text"
        app:layout_constraintBottom_toTopOf="@id/grupobtn"
        app:layout_constraintLeft_toRightOf="@id/labelnumero"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/teclaPulsada"/>

    <RadioGroup
        android:id="@+id/grupobtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtnumero"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnLimpiar"
        android:orientation="horizontal"
        >
    <RadioButton
            android:id="@+id/rbSi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Si"
            tools:layout_editor_absoluteX="28dp"
            tools:layout_editor_absoluteY="671dp"
            app:layout_constraintTop_toBottomOf="@id/txtnumero"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/rbNo"
            app:layout_constraintStart_toStartOf="parent"
            />

        <RadioButton
            android:id="@+id/rbNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No"
            tools:layout_editor_absoluteX="28dp"
            tools:layout_editor_absoluteY="671dp"
            app:layout_constraintTop_toBottomOf="@id/txtnumero"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/rbVeces"
            app:layout_constraintStart_toEndOf="@id/rbSi"/>


        <RadioButton
            android:id="@+id/rbVeces"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A veces"
            tools:layout_editor_absoluteX="28dp"
            tools:layout_editor_absoluteY="671dp"
            app:layout_constraintTop_toBottomOf="@id/txtnumero"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnLimpiar"
            app:layout_constraintStart_toEndOf="@id/rbNo"        />

    </RadioGroup>

    <Button
        android:id="@+id/btnLimpiar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Limpiar"
        tools:layout_editor_absoluteX="324dp"
        tools:layout_editor_absoluteY="669dp"
        app:layout_constraintTop_toBottomOf="@id/txtnumero"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/grupobtn"
        app:layout_constraintEnd_toEndOf="parent">

    </Button>

</androidx.constraintlayout.widget.ConstraintLayout>