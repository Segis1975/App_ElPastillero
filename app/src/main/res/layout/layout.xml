<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFF5F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- CABECERA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💊 ElPastillero"
                android:textColor="#176B70"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <ImageButton
                android:id="@+id/btnAjustes"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@android:drawable/ic_menu_preferences"
                android:backgroundTint="#D8EDEF"
                android:contentDescription="Ajustes"
                android:padding="12dp"
                android:scaleType="fitCenter"/>

        </LinearLayout>

        <!-- SALUDO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡Buenos días!"
            android:textColor="#263F46"
            android:textSize="27sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tu salud, organizada cada día."
            android:textColor="#60777D"
            android:textSize="18sp"
            android:layout_marginTop="5dp"/>

        <!-- RESUMEN DEL DIA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:padding="18dp"
            android:layout_marginTop="25dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅 Resumen de hoy"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#263F46"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTotalMedicamentos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#167D83"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medicamentos"
                        android:textSize="16sp"
                        android:textColor="#60777D"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTomasPendientes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#D58A26"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tomas pendientes"
                        android:textSize="16sp"
                        android:textColor="#60777D"/>

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- MENU PRINCIPAL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Qué necesitas?"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#263F46"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="15dp"/>

        <!-- FILA 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- MEDICAMENTOS -->
            <LinearLayout
                android:id="@+id/btnMedicamentos"
                android:layout_width="0dp"
                android:layout_height="155dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#FFFFFF"
                android:elevation="3dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Consultar medicamentos">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💊"
                    android:textSize="45sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medicamentos"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#176B70"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Consultar y gestionar"
                    android:textSize="13sp"
                    android:textColor="#60777D"
                    android:gravity="center"/>

            </LinearLayout>

            <!-- CITAS MEDICAS -->
            <LinearLayout
                android:id="@+id/btnCitas"
                android:layout_width="0dp"
                android:layout_height="155dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#FFFFFF"
                android:elevation="3dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Consultar citas médicas">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🩺"
                    android:textSize="45sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Citas médicas"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#3983B9"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Próximas consultas"
                    android:textSize="13sp"
                    android:textColor="#60777D"
                    android:gravity="center"/>

            </LinearLayout>

        </LinearLayout>

        <!-- FILA 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- CONTROL DE TOMAS -->
            <LinearLayout
                android:id="@+id/btnControlTomas"
                android:layout_width="0dp"
                android:layout_height="155dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#FFFFFF"
                android:elevation="3dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Control de tomas">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋"
                    android:textSize="45sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Control de tomas"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#26966C"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registrar medicamentos"
                    android:textSize="13sp"
                    android:textColor="#60777D"
                    android:gravity="center"/>

            </LinearLayout>

            <!-- FAMILIARES -->
            <LinearLayout
                android:id="@+id/btnFamiliares"
                android:layout_width="0dp"
                android:layout_height="155dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#FFFFFF"
                android:elevation="3dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Contactos familiares">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👨‍👩‍👧"
                    android:textSize="45sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Familiares"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#A16BB4"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contactos y seguimiento"
                    android:textSize="13sp"
                    android:textColor="#60777D"
                    android:gravity="center"/>

            </LinearLayout>

        </LinearLayout>

        <!-- PROXIMA TOMA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:padding="18dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔔 Próxima toma"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#263F46"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Paracetamol"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#176B70"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="20:00 h - Según prescripción"
                android:textSize="17sp"
                android:textColor="#60777D"
                android:layout_marginTop="5dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
