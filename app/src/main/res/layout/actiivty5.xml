<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Actiivty5">

    <Button
        android:id="@+id/btnToma"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:text="Confirmar toma de medicamento"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnInvitacion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <Button
        android:id="@+id/btnInvitacion"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Contactar con un familiar"
        app:layout_constraintBottom_toTopOf="@id/btnVolver"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnToma" />

    <Button
        android:id="@+id/btnVolver"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Volver atras"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnInvitacion" />

</androidx.constraintlayout.widget.ConstraintLayout>