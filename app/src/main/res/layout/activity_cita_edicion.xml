<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margen">

        <TextView
            android:id="@+id/txtTituloCita"
            style="@style/Estilo.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cita_nueva" />

        <TextView
            style="@style/Estilo.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen"
            android:text="@string/cita_especialidad" />

        <Spinner
            android:id="@+id/spEspecialidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etMedico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cita_medico"
            android:inputType="textPersonName"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etLugar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cita_lugar"
            android:inputType="text"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnElegirFechaHora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen_pequeno"
            android:text="@string/form_elegir_fecha" />

        <TextView
            android:id="@+id/txtFechaHoraCita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/margen_pequeno"
            android:text="@string/cita_sin_fecha"
            android:textColor="@color/texto_secundario" />

        <EditText
            android:id="@+id/etNotasCita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cita_notas"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnGuardarCita"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/guardar" />

            <Button
                android:id="@+id/btnCancelarCita"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pequeno"
                android:layout_weight="1"
                android:text="@string/cancelar" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
