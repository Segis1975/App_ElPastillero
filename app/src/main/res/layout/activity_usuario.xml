<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Usuario">

    <TextView
        android:id="@+id/lbNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre:"
        tools:layout_editor_absoluteX="45dp"
        tools:layout_editor_absoluteY="34dp" />

    <TextView
        android:id="@+id/lblDNI"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="D.N.I.:"
        tools:layout_editor_absoluteX="45dp"
        tools:layout_editor_absoluteY="34dp" />

    <TextView
        android:id="@+id/lblLocalidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre"
        tools:layout_editor_absoluteX="45dp"
        tools:layout_editor_absoluteY="34dp" />

    <TextView
        android:id="@+id/lbcp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Codigo Postal:"
        tools:layout_editor_absoluteX="45dp"
        tools:layout_editor_absoluteY="34dp" />

    <TextView
        android:id="@+id/lbProvincia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Provincia"
        tools:layout_editor_absoluteX="45dp"
        tools:layout_editor_absoluteY="34dp" />

    <EditText
        android:id="@+id/txtNombre6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Name"
        tools:layout_editor_absoluteX="128dp"
        tools:layout_editor_absoluteY="43dp" />

    <EditText
        android:id="@+id/txtNombre5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Name"
        tools:layout_editor_absoluteX="128dp"
        tools:layout_editor_absoluteY="43dp" />

    <EditText
        android:id="@+id/txtLocalidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Name"
        tools:layout_editor_absoluteX="128dp"
        tools:layout_editor_absoluteY="43dp" />

    <EditText
        android:id="@+id/txtDNI"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Name"
        tools:layout_editor_absoluteX="128dp"
        tools:layout_editor_absoluteY="43dp" />

    <TextView
        android:id="@+id/lbDireccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Domicilio:"
        tools:layout_editor_absoluteX="45dp"
        tools:layout_editor_absoluteY="34dp" />

    <EditText
        android:id="@+id/txtDomicilio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Name"
        tools:layout_editor_absoluteX="128dp"
        tools:layout_editor_absoluteY="43dp" />

    <EditText
        android:id="@+id/txtNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Name"
        tools:layout_editor_absoluteX="128dp"
        tools:layout_editor_absoluteY="43dp" />
</androidx.constraintlayout.widget.ConstraintLayout>